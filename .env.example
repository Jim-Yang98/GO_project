# PostgreSQL 應用資料庫
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Airflow 認證與加密金鑰
# JWT密鑰：scheduler/webserver/dag-processor 之間認證用，三者必須共用同一組值
AIRFLOW_JWT_SECRET=change_me
# Fernet密鑰：用於加密 Airflow connections/variables 裡的敏感資料
AIRFLOW_FERNET_KEY=change_me
# API secret key：Airflow api-server 內部使用
AIRFLOW_API_SECRET_KEY=change_me

# 應用程式連線設定
DB_HOST=postgres-app
DB_PORT=5432
DB_NAME=go_project_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# 第三方 API
GEMINI_API_KEY=your_gemini_api_key_here

# Airflow 執行環境相關
AIRFLOW_UID=50000